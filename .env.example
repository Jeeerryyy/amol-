# ==============================================================================
# Environment Configuration - Amol Veg Resto Unified Platform
# Copy this file to .env and provide your deployment-specific credentials.
# NEVER commit the actual .env file with secrets to source control.
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=development
PORT=3001

# PostgreSQL Database (Supabase, Neon, or Render PostgreSQL)
# Example: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
DATABASE_SSL=true

# AI Provider Configuration (Google Gemini / Anthropic)
# Get a key from Google AI Studio: https://aistudio.google.com/
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (Comma-separated for multiple domains)
# Example: http://localhost:5173,https://amolvegresto.in,https://amol-veg-resto.vercel.app
ALLOWED_ORIGIN=http://localhost:5173,https://amolvegresto.in

# Restaurant Administration Credentials
ADMIN_EMAIL=owner@amolvegresto.in
ADMIN_INITIAL_PASSWORD=ChangeThisToYourSecurePassword123!

# Security & QR Anonymization Salt (Min 32 characters)
IP_HASH_SALT=amol_qr_salt_secure_change_in_production_2026

# AI Review Generation Rate Limiting
RATE_LIMIT_PER_MIN=12
RATE_LIMIT_PER_DAY=100

# Cloudinary Media Storage (Optional: uploads simulated locally if omitted)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Canonical Site URL
SITE_URL=https://amolvegresto.in

# Frontend API URL (Set in Vercel if backend is deployed separately on Render)
# Example: https://amol-backend.onrender.com
# Leave blank or omit for local dev and relative proxy.
# VITE_API_URL=https://amol-backend.onrender.com
